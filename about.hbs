<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>galaxync third-party licenses</title>
  <style>
    body { font-family: sans-serif; margin: 2rem auto; max-width: 72rem; padding: 0 1rem; }
    pre { border: 1px solid #ddd; overflow-x: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>galaxync third-party licenses</h1>
  <p>This report covers Rust dependencies included in the galaxync binary.</p>
  {{#each licenses}}
    <section>
      <h2>{{name}}</h2>
      <p>Used by:</p>
      <ul>
        {{#each used_by}}
          <li>{{crate.name}} {{crate.version}}</li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
  {{/each}}
</body>
</html>
